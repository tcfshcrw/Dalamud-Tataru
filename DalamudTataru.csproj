<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>

    <Authors>winw1010, Dalumud-Tataru Team</Authors>
    <Company>Tataru Assistant Community</Company>
    <Version>0.26.45.200</Version>
    <Description>Native Dalamud plugin for real-time Japanese to Traditional/Simplified Chinese dialogue and subtitle translation powered by Google Gemini and Tataru Assistant dictionaries.</Description>
    <PackageProjectUrl>https://github.com/tcfshcrw/Dalumud-Tataru</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="DalamudTataru.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
